// Firestore security rules for the SHE Home Task Organizer.
//
// WHERE TO PASTE: Firebase console → Build → Firestore Database → Rules tab.
// Replace the entire contents of the rules editor with this file, then click Publish.
//
// WHAT IT DOES: The app signs in anonymously (no login screen). Each visitor
// gets a unique anonymous user ID, and these rules let a signed-in user read
// and write ONLY their own data under users/{their-uid}/ — never anyone else's.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
